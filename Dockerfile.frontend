FROM node:18-alpine

WORKDIR /app

# Copy dependency manifest from the app directory and install
COPY app/package*.json ./
RUN npm install

# Copy all frontend files (including index.html, tsconfig, vite.config) into the working directory
COPY app/ ./

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server bound to 0.0.0.0 so Docker/Podman can map ports
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
