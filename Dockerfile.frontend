FROM node:18-alpine

WORKDIR /app

# CHANGE THIS: Remove "app/" from the source path
# OLD: COPY app/package*.json ./
# NEW:
COPY package*.json ./

RUN npm install

# CHANGE THIS: Copy from root context instead of app/
# OLD: COPY app/ ./
# NEW:
COPY . ./

RUN npm run build

# Add your serving/preview step here (e.g., using nginx or vite preview)
